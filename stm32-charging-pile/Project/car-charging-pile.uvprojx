<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="project_projx.xsd">
  <Target>
    <TargetName>STM32F103ZE</TargetName>
    <TargetOption>
      <TargetCommonOption>
        <Device>STM32F103ZE</Device>
        <Vendor>STMicroelectronics</Vendor>
        <PackID>Keil.STM32F1xx_DFP.2.3.0</PackID>
        <Cpu>IRAM(0x20000000,0x00010000) IROM(0x08000000,0x00080000) CPUTYPE("Cortex-M3") CLOCK(72000000) ESEL ELITTLE</Cpu>
        <FlashUtilSpec/>
        <StartupFile>./../Startup/startup_stm32f10x_hd.s</StartupFile>
        <FlashDriverDll>UL2CM3(-S0 -C0 -P0 -FD20000000 -FC1000 -FN1 -FF0STM32F10x_High-density_Flash -FS02000000000000001 -FL0100000 -FP0($$Device:STM32F103ZE$Flash\STM32F10x_High-density_Flash.FLM))</FlashDriverDll>
        <DeviceId>0</DeviceId>
        <RegisterFile>$$Device:STM32F103ZE$Drivers\CMSIS\Device\ST\STM32F1xx\Include\stm32f10x.h</RegisterFile>
        <MemoryAreaConfirmation>1</MemoryAreaConfirmation>
        <TargetClock>
          <Clock>8000000</Clock>
        </TargetClock>
      </TargetCommonOption>
      <CadsArm>
        <interw>1</interw>
        <Optim>2</Optim>
        <OneElf>1</OneElf>
        <Strict>0</Strict>
        <EnumInt>0</EnumInt>
        <PlainChar>0</PlainChar>
        <Ropi>0</Ropi>
        <Rwpi>0</Rwpi>
        <wLevel>1</wLevel>
        <uThumb>0</uThumb>
        <uMerge>1</uMerge>
        <Includes>./../User;./../Hardware;./../Hardware/sensor;./../Hardware/storage;./../Hardware/communication;./../Hardware/display;./../Hardware/control;./../Hardware/buzzer;./../Hardware/key;./../Libraries/CMSIS;./../Libraries/STM32F10x_StdPeriph_Driver/inc</Includes>
        <MiscControls/>
        <Define>USE_STDPERIPH_DRIVER,STM32F10X_HD</Define>
        <Undefine/>
      </CadsArm>
      <AadsArm>
        <interw>1</interw>
        <Ropi>0</Ropi>
        <Rwpi>0</Rwpi>
        <thumb>1</thumb>
        <Alp>2</Alp>
        <Includes/>
        <MiscControls/>
      </AadsArm>
    </TargetOption>
    <Group>
      <GroupName>Startup</GroupName>
      <File>
        <FileName>startup_stm32f10x_hd.s</FileName>
        <FileType>1</FileType>
        <FilePath>.\..\Startup\startup_stm32f10x_hd.s</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>User</GroupName>
      <File>
        <FileName>main.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\User\main.c</FilePath>
      </File>
      <File>
        <FileName>system_stm32f10x.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\User\system_stm32f10x.c</FilePath>
      </File>
      <File>
        <FileName>delay.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\User\delay.c</FilePath>
      </File>
      <File>
        <FileName>stm32f10x_it.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\User\stm32f10x_it.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Sensor</GroupName>
      <File>
        <FileName>mq2.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\sensor\mq2.c</FilePath>
      </File>
      <File>
        <FileName>dht11.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\sensor\dht11.c</FilePath>
      </File>
      <File>
