        <FileType>8</FileType>
        <FilePath>.\..\Hardware\sensor\light_sensor.c</FilePath>
      </File>
      <File>
        <FileName>ir_remote.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\sensor\ir_remote.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Storage</GroupName>
      <File>
        <FileName>w25q64.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\storage\w25q64.c</FilePath>
      </File>
      <File>
        <FileName>at24c02.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\storage\at24c02.c</FilePath>
      </File>
      <File>
        <FileName>sd_sdio.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\storage\sd_sdio.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Comm</GroupName>
      <File>
        <FileName>usart.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\communication\usart.c</FilePath>
      </File>
      <File>
        <FileName>rs485.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\communication\rs485.c</FilePath>
      </File>
      <File>
        <FileName>nrf24l01.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\communication
rf24l01.c</FilePath>
      </File>
      <File>
        <FileName>esp8266.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\communication\esp8266.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Display</GroupName>
      <File>
        <FileName>lcd.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\display\lcd.c</FilePath>
      </File>
      <File>
        <FileName>touch.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\display\touch.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Control</GroupName>
      <File>
        <FileName>relay.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\control\relay.c</FilePath>
      </File>
      <File>
        <FileName>stepper.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\control\stepper.c</FilePath>
      </File>
      <File>
        <FileName>dc_motor.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\control\dc_motor.c</FilePath>
      </File>
      <File>
        <FileName>led.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\control\led.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>Hardware/Other</GroupName>
      <File>
        <FileName>buzzer.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\buzzer\buzzer.c</FilePath>
      </File>
      <File>
        <FileName>key.c</FileName>
        <FileType>8</FileType>
        <FilePath>.\..\Hardware\key\key.c</FilePath>
      </File>
    </Group>
    <Group>
      <GroupName>SPL</GroupName>
    </Group>
  </Target>
</Project>
